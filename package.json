{
  "name": "playwright-automation",
  "version": "1.0.0",
  "description": "Playwright end-to-end tests running on Termux (Android) with system Chromium",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "PLAYWRIGHT_BROWSERS_PATH=0 node ./node_modules/@playwright/test/cli.js test",
    "test:headed": "PLAYWRIGHT_BROWSERS_PATH=0 node ./node_modules/@playwright/test/cli.js test --headed",
    "report": "PLAYWRIGHT_BROWSERS_PATH=0 node ./node_modules/@playwright/test/cli.js show-report",
    "codegen": "PLAYWRIGHT_BROWSERS_PATH=0 node ./node_modules/@playwright/test/cli.js codegen"
  },
  "keywords": [
    "playwright",
    "termux",
    "android",
    "e2e",
    "testing"
  ],
  "author": "Hieu Dam",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.5",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
